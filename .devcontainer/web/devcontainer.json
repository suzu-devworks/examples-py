// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
  "name": "Python (uv with Web)",
  "dockerComposeFile": [
    "../compose.yaml",
    "../compose.dev-web.yaml"
  ],
  "service": "dev-web",
  "runServices": [
    "dev-web",
    "nginx"
  ],
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "postCreateCommand": "/bin/sh ./.devcontainer/postCreateCommand.sh",
  "remoteUser": "vscode",
  "remoteEnv": {
    "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}",
    "UV_LINK_MODE": "copy"
  },
  "mounts": [
    "source=uv-venv,target=${containerWorkspaceFolder}/.venv,type=volume",
    "source=${localEnv:HOME}/.copilot/instructions,target=/home/vscode/.copilot/instructions,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.copilot/skills,target=/home/vscode/.copilot/skills,type=bind,consistency=cached"
  ],
  "features": {
    "ghcr.io/devcontainers/features/copilot-cli": {},
    "ghcr.io/devcontainers/features/github-cli": {},
    "ghcr.io/devcontainers/features/node": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "EditorConfig.EditorConfig",
        "streetsidesoftware.code-spell-checker",
        "DavidAnson.vscode-markdownlint",
        "ms-python.python",
        "ms-python.mypy-type-checker",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml"
      ],
      "settings": {
        // Enable Copilot Chat code generation to use instruction files
        "github.copilot.chat.codeGeneration.useInstructionFiles": true
      }
    }
  }
}
